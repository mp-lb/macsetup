export ZSH="$HOME/.oh-my-zsh"
plugins=(git docker docker-compose brew)

_MACSETUP_ZSHRC_DIR="${${(%):-%x}:A:h}"
source "$_MACSETUP_ZSHRC_DIR/../lib/paths.sh"
unset _MACSETUP_ZSHRC_DIR
source $ZSH/oh-my-zsh.sh
source "$MACSETUP_REPO_PATH/env/zsh-theme.sh"

if [ -x /opt/homebrew/bin/mise ]; then
  eval "$(/opt/homebrew/bin/mise activate zsh)"
fi

path+=("/opt/homebrew/bin")
path+=("$MACSETUP_REPO_PATH/bin")
path+=("$HOME/.local/bin")
alias gpop="git reset HEAD^"
alias gtsync="git fetch --tags && git push origin --tags"
alias yolo="claude --dangerously-skip-permissions"
[[ -f "$MACSETUP_REPO_PATH/zshrc-user.sh" ]] && source "$MACSETUP_REPO_PATH/zshrc-user.sh"
